# Copiar a .env y ajustar. El .env NO se sube al repo.
PORT=3000

# Postgres local de docker-compose (puerto 5433 en tu máquina -> 5432 en el contenedor)
DATABASE_URL=postgresql://admin:is2026@localhost:5433/is_db

# Origen del frontend permitido por CORS
FRONTEND_URL=http://localhost:5173

# Secretos de autenticación. Cada uno genera los suyos (y en producción, otros distintos):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# JWT_SECRET firma los tokens de sesión. Si cambia, todas las sesiones se cierran.
JWT_SECRET=cambiar-por-un-valor-aleatorio
# PIN_SECRET se usa para el HMAC de los PINs. Si cambia, TODOS los PINs dejan de funcionar.
PIN_SECRET=cambiar-por-otro-valor-aleatorio
